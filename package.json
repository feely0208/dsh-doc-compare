{
  "name": "@deepwhale-cn/dsh-doc-compare",
  "version": "0.1.0",
  "description": "文档/合同比对：把两份 Word / Markdown / 文本按段落比对成「改前 → 改后」的人能读报告，单独提示标题层级与表格行数变化，可出 Markdown 报告与 JSON",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepwhale",
    "doc-compare",
    "diff",
    "contract",
    "文档比对",
    "合同比对"
  ],
  "files": [
    "lib",
    "bin",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/diff.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-doc-compare": "./bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "mammoth": "^1.13.0"
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-doc-compare.git"
  },
  "homepage": "https://www.deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-doc-compare/issues"
  },
  "scripts": {
    "test": "bash tests/run.sh"
  }
}
